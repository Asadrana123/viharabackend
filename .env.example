# ---------------------------------------------------------------------------
# Meta Ads Loop (Zernio + Claude + Slack approvals). See ads-loop.md.
# ---------------------------------------------------------------------------
# "true" turns on the schedules (daily pull 06:00 IST, heartbeat, weekly list Mon 09:00 IST).
ADS_LOOP_ENABLED=false

# Zernio (https://zernio.com, API key starts with sk_)
ZERNIO_API_KEY=
# Zernio account id of the connected Meta ads account (GET /api/v1/ads-loop/zernio/accounts shows it)
ZERNIO_ADS_ACCOUNT_ID=
# Meta ad account id of "Vihara New" (act_...)
ZERNIO_AD_ACCOUNT_ID=
# Zernio account ids for organic posts (leave one empty to skip that platform)
ZERNIO_FACEBOOK_ACCOUNT_ID=6acddebe6a3a42b4a1a804a8
ZERNIO_INSTAGRAM_ACCOUNT_ID=

# Slack app "Vihara Ads Loop" (bot token + signing secret, see ads-loop.md)
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_CREATIVE_REVIEW_CHANNEL_ID=
SLACK_ADS_WEEKLY_CHANNEL_ID=
# Comma-separated Slack user ids (U0123...) allowed to approve. Empty = nobody can approve.
SLACK_APPROVER_IDS=

# Guardrails (USD)
ADS_LOOP_DAILY_SPEND_CEILING=50
ADS_LOOP_MONTHLY_SPEND_CEILING=1000
ADS_LOOP_DEFAULT_DAILY_BUDGET=10

# Optional
# ADS_LOOP_AD_GOAL=traffic
# ADS_LOOP_CAMPAIGN_SLUG=vihara-auctions
# ADS_LOOP_CITY_RADIUS_MILES=25
# ADS_LOOP_ACCOUNT_TZ=America/Los_Angeles
# ADS_LOOP_CRITIC_THRESHOLD=7
# ADS_LOOP_ORGANIC_DELAY_HOURS=2
# ADS_LOOP_MODEL=claude-opus-5-5
# Daily Meta ads report (metaAdsAnalystService.js) and daily website report summary (gaSummaryService.js).
# META_ADS_ANALYST_MODEL=claude-opus-5-5
# META_ADS_ANALYST_EFFORT=high
# GA_SUMMARY_MODEL=claude-sonnet-5-5
# META_ADS_SUMMARY_MODEL=claude-sonnet-5-5   # shortens the Meta ads report for Slack (metaAdsShortReport.js)
# META_PIXEL_ID=

# Image hosting: approved PNGs go to Cloudinary (already used by the backend)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# VIHARA_LOGO_URL=
# ANTHROPIC_API_KEY=

# --- Repair agent (daily tracking + landing page checks; fixes wait for Go in Slack) ---
REPAIR_AGENT_ENABLED=false
# Fine-grained token: Contents + Pull requests (read/write), Deployments (read) on the backend repo
REPAIR_GITHUB_TOKEN=
# Token for the website repo (Adarsh-Raut/vihara-next). Falls back to REPAIR_GITHUB_TOKEN.
# Needed because a fine-grained token only reaches repos owned by its own account.
REPAIR_WEBSITE_GITHUB_TOKEN=
# Slack channel for incidents (defaults to SLACK_ADS_WEEKLY_CHANNEL_ID). Go/Reject uses SLACK_APPROVER_IDS.
SLACK_REPAIR_CHANNEL_ID=
# REPAIR_WEBSITE_REPO=Adarsh-Raut/vihara-next
# REPAIR_BACKEND_REPO=Asadrana123/viharabackend
# REPAIR_SITE_URL=https://www.vihara.ai
# REPAIR_AGENT_MAX_COST_USD=5
# Every server-side CompleteRegistration is also sent to Meta as Lead (same event_id). "false" turns it off.
# META_CAPI_MIRROR_LEAD=true

# --- Sign-up doctor (daily 07:45 IST: why ad landing pages get visitors but few sign-ups; report only) ---
SIGNUP_DOCTOR_ENABLED=false
# Clarity → Settings → Data Export → Generate new API token (optional but recommended)
CLARITY_API_TOKEN=
# Slack channel for reports (defaults to SLACK_REPAIR_CHANNEL_ID). Run any time: /adsloop why [page link]
SLACK_SIGNUP_DOCTOR_CHANNEL_ID=
# SIGNUP_DOCTOR_MAX_COST_USD=3
# SIGNUP_DOCTOR_MAX_PAGES=5
# SIGNUP_DOCTOR_MAX_MINUTES=12
# Speed + screenshots through Google PageSpeed (falls back to GEMINI_API_KEY; enable the
# "PageSpeed Insights API" in that key's Google Cloud project)
PAGESPEED_API_KEY=
# Our own Chrome for test-filling forms: needs a 2 GB+ server. Leave off on the 512 MB plan.
# SIGNUP_DOCTOR_BROWSER=false

# Instagram comment auto-reply through Zernio (services/social/commentReplyService.js)
# Secret of the Zernio webhook subscription (comment.received -> https://api.vihara.ai/api/webhooks/zernio)
ZERNIO_WEBHOOK_SECRET=
ZERNIO_AUTO_REPLY_ENABLED=false
ZERNIO_AUTO_REPLY_PLATFORMS=instagram
# Slack log of every reply / skip: a channel the bot is in (or SLACK_SOCIAL_WEBHOOK_URL)
SLACK_SOCIAL_CHANNEL_ID=

# ---------------------------------------------------------------------------
# Slides agent: Google account connection (Google Cloud project vihara-slides-agent)
# ---------------------------------------------------------------------------
# OAuth client of type "Web application"
GOOGLE_SLIDES_CLIENT_ID=
GOOGLE_SLIDES_CLIENT_SECRET=
# Must match an "Authorized redirect URI" on that client exactly
GOOGLE_SLIDES_REDIRECT_URI=http://localhost:5000/api/v1/google-slides/callback
# Encrypts the saved Google token: 32 bytes as 64 hex chars
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GOOGLE_SLIDES_TOKEN_KEY=
# Google Slides file id of the Vihara template deck (layouts named VIHARA_*)
GOOGLE_SLIDES_TEMPLATE_ID=
# Also needed: CLIENT_URL (admin panel address)

# Facebook / Instagram instant-form leads through Zernio (lead.received -> /api/webhooks/zernio)
# -> Admin "Facebook Forms" tab, welcome email, Brevo, and Maya calls when the form has call consent.
ZERNIO_LEADS_ENABLED=false
# Automatic Vtext intro text to each NEW Facebook form lead that gave call/text consent (also needs VTEXT_ENABLED=true). Off by default.
FACEBOOK_AUTO_TEXT_ENABLED=false
# Automatic Vtext first text for NEW website-form leads (services/vtext/formIntroTexts.js). Follows the Vtext consent
# switch (ON: SMS box ticked only; OFF: everyone), 9 AM-8 PM in the lead's time zone, no follow-ups. Comma list of forms, or "all"; empty = none. Also needs VTEXT_ENABLED=true.
# Forms: dealFinancing, dealFinder, norcal, partner, newDeals, buyerList, earlyAccess, landingPage, auctionRegistration, sell
VTEXT_FORM_TEXTS=
# Cal.com advisor-call reminders as Vtext texts. The webhook (POST /api/webhooks/calcom) needs the
# secret set on the Cal.com webhook; sending also needs CALCOM_REMINDERS_ENABLED=true and VTEXT_ENABLED=true.
CALCOM_WEBHOOK_SECRET=
CALCOM_REMINDERS_ENABLED=false
# Minutes before the call, comma-separated (e.g. 1440,30). Default 30.
CALCOM_REMINDER_MINUTES=30
# Cal.com event slugs that get reminders (comma-separated).
CALCOM_REMINDER_EVENTS=walkthrough,15min
# Old direct Meta leadgen webhook that called every lead about one property (keep off).
FB_LEADGEN_DIRECT_CALLS=false

# Twilio SMS fallback: when an iMessage cannot be delivered, send the same text once by SMS through the Twilio line.
# Off by default. Full runbook: twilio-sms.md. Twilio's own keys are NOT env vars: they are stored encrypted on each line
# in Vtext -> Lines (needs VTEXT_ENABLED=true, VTEXT_PUBLIC_BASE_URL and VTEXT_SECRETS_KEY).
VTEXT_SMS_FALLBACK_ENABLED=false
# What to do when an iMessage has no delivery receipt after 10 minutes (a missing receipt does not prove it failed):
#   verify = send nothing, a person decides with the "Send by SMS" button (default)   auto = send by SMS   off = nothing
VTEXT_SMS_FALLBACK_NO_RECEIPT_MODE=verify
# iMessage receipt error codes that mean "not delivered" and send the SMS straight away (22 = not an iMessage number)
VTEXT_SMS_FALLBACK_IMESSAGE_CODES=22
# Never send a fallback for an iMessage older than this
VTEXT_SMS_FALLBACK_MAX_AGE_HOURS=24
# Most fallback texts created in one hour, across all lines
VTEXT_SMS_FALLBACK_MAX_PER_HOUR=30
# Slack: each text that does not get out is posted on its own (vtextTextProblemAlert.js). Past this many in one hour,
# the rest are held back and one "Many texts are failing" alert is sent instead.
VTEXT_TEXT_ALERTS_PER_HOUR=20
# How long Twilio keeps trying to deliver one text before giving up, in seconds (default 4 hours)
VTEXT_TWILIO_VALIDITY_SECONDS=14400

# Google reCAPTCHA checkbox on public forms (middleware/recaptcha.js).
# Key made in Google Cloud project vihara-next-website (Security -> Fraud Defense -> Keys).
# RECAPTCHA_API_KEY: a Cloud API key restricted to "reCAPTCHA Enterprise API". Empty = captcha checks are off.
RECAPTCHA_PROJECT_ID=vihara-next-website
RECAPTCHA_SITE_KEY=
RECAPTCHA_API_KEY=

# Gemini text model for Vtext AI replies, property descriptions and marketing copy. Empty = gemini-3.8-flash.
# Google retires models, so change it here instead of in code. Embeddings use GEMINI_EMBED_MODEL.
GEMINI_MODEL=

# Local runs: set to true so this machine never calls, texts or emails real people or posts to Slack (the
# local DB holds copies of real leads). Skips the call/text jobs and the in-process Vtext workers, refuses
# every Maya call, and blocks sends to Brevo, Slack, Twilio, Sendblue, Vapi and Gmail.
# See src/config/outboundSwitch.js. Never set on Render.
OUTBOUND_DISABLED=

# Property Funnel admin tab: "db" sends real data from our collections; unset (default) = the tab shows
# its built-in sample data. See src/controller/propertyFunnel/propertyFunnelController.js.
PROPERTY_FUNNEL_SOURCE=

# Property Funnel sync jobs (Meta ads + organic posts via Zernio, GA4, Clarity, Sanity) on a Pacific schedule.
# "true" to run them (src/jobs/propertyFunnelJob.js). Run one by hand: node src/scripts/propertyFunnelSync.js ads
PROPERTY_FUNNEL_SYNC_ENABLED=
# Optional: Sanity read token, only to include draft blog posts.
SANITY_READ_TOKEN=
