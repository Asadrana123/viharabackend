# ---------------------------------------------------------------------------
# Meta Ads Loop (Zernio + Claude + Slack approvals). See ads-loop.md.
# ---------------------------------------------------------------------------
# "true" turns on the schedules (daily pull 06:00 IST, heartbeat, weekly list Mon 09:00 IST).
ADS_LOOP_ENABLED=false

# Zernio (https://zernio.com, API key starts with sk_)
ZERNIO_API_KEY=
# Zernio account id of the connected Meta ads account (GET /api/v1/ads-loop/zernio/accounts shows it)
ZERNIO_ADS_ACCOUNT_ID=
# Meta ad account id of "Vihara New" (act_...)
ZERNIO_AD_ACCOUNT_ID=
# Zernio account ids for organic posts (leave one empty to skip that platform)
ZERNIO_FACEBOOK_ACCOUNT_ID=6acddebe6a3a42b4a1a804a8
ZERNIO_INSTAGRAM_ACCOUNT_ID=

# Slack app "Vihara Ads Loop" (bot token + signing secret, see ads-loop.md)
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_CREATIVE_REVIEW_CHANNEL_ID=
SLACK_ADS_WEEKLY_CHANNEL_ID=
# Comma-separated Slack user ids (U0123...) allowed to approve. Empty = nobody can approve.
SLACK_APPROVER_IDS=

# Guardrails (USD)
ADS_LOOP_DAILY_SPEND_CEILING=50
ADS_LOOP_MONTHLY_SPEND_CEILING=1000
ADS_LOOP_DEFAULT_DAILY_BUDGET=10

# Optional
# ADS_LOOP_AD_GOAL=traffic
# ADS_LOOP_CAMPAIGN_SLUG=vihara-auctions
# ADS_LOOP_CITY_RADIUS_MILES=25
# ADS_LOOP_ACCOUNT_TZ=America/Los_Angeles
# ADS_LOOP_CRITIC_THRESHOLD=7
# ADS_LOOP_ORGANIC_DELAY_HOURS=2
# ADS_LOOP_MODEL=claude-opus-5-5
# META_PIXEL_ID=

# Image hosting: approved PNGs go to Cloudinary (already used by the backend)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# VIHARA_LOGO_URL=
# ANTHROPIC_API_KEY=

# --- Repair agent (daily tracking + landing page checks; fixes wait for Go in Slack) ---
REPAIR_AGENT_ENABLED=false
# Fine-grained token: Contents + Pull requests (read/write), Deployments (read) on BOTH repos
REPAIR_GITHUB_TOKEN=
# Slack channel for incidents (defaults to SLACK_ADS_WEEKLY_CHANNEL_ID). Go/Reject uses SLACK_APPROVER_IDS.
SLACK_REPAIR_CHANNEL_ID=
# REPAIR_WEBSITE_REPO=Asadrana123/vihara-new-website
# REPAIR_BACKEND_REPO=Asadrana123/viharabackend
# REPAIR_SITE_URL=https://www.vihara.ai
# REPAIR_AGENT_MAX_COST_USD=5
# Every server-side CompleteRegistration is also sent to Meta as Lead (same event_id). "false" turns it off.
# META_CAPI_MIRROR_LEAD=true

# --- Sign-up doctor (daily 07:45 IST: why ad landing pages get visitors but few sign-ups; report only) ---
SIGNUP_DOCTOR_ENABLED=false
# Clarity → Settings → Data Export → Generate new API token (optional but recommended)
CLARITY_API_TOKEN=
# Slack channel for reports (defaults to SLACK_REPAIR_CHANNEL_ID). Run any time: /adsloop why [page link]
SLACK_SIGNUP_DOCTOR_CHANNEL_ID=
# SIGNUP_DOCTOR_MAX_COST_USD=3
# SIGNUP_DOCTOR_MAX_PAGES=5

# Instagram comment auto-reply through Zernio (services/social/commentReplyService.js)
# Secret of the Zernio webhook subscription (comment.received -> https://api.vihara.ai/api/webhooks/zernio)
ZERNIO_WEBHOOK_SECRET=
ZERNIO_AUTO_REPLY_ENABLED=false
ZERNIO_AUTO_REPLY_PLATFORMS=instagram
# Slack log of every reply / skip: a channel the bot is in (or SLACK_SOCIAL_WEBHOOK_URL)
SLACK_SOCIAL_CHANNEL_ID=
