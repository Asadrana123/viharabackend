# Copy to .env and fill in.

# Backend the worker talks to (the same server the admin panel uses).
QA_API_URL=http://localhost:5000
# Must match QA_AGENT_TOKEN in the backend's .env (32+ characters).
QA_AGENT_TOKEN=
# Name for this worker in run locks/logs (letters, numbers, _ . : -).
QA_WORKER_ID=qa-worker-1

# Claude API key used by the agent.
ANTHROPIC_API_KEY=
# Model for planning and testing.
QA_MODEL=claude-opus-5-5
# Cheaper model that first checks whether a request makes sense to test.
QA_TRIAGE_MODEL=claude-haiku-4-5

# Local checkouts the agent reads (absolute paths).
QA_BACKEND_REPO=c:/dev/viharabackend
QA_FRONTEND_REPO=c:/dev/vihara-new-website

# Seconds between checks for new work when idle.
QA_POLL_SECONDS=15
